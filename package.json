{
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "name": "sainthr-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:workspace": "rm -rf node_modules apps/api/node_modules apps/worker/node_modules apps/api/dist apps/worker/dist apps/api/coverage apps/worker/coverage",
    "api:start": "pnpm --dir apps/api start",
    "api:dev": "pnpm --dir apps/api start:dev",
    "api:debug": "pnpm --dir apps/api start:debug",
    "api:prod": "pnpm --dir apps/api start:prod",
    "api:nest": "pnpm --dir apps/api exec nest",
    "db:seed": "pnpm run --dir apps/api prisma:seed",
    "db:migrate:dev": "pnpm run --dir apps/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm run --dir apps/api prisma:migrate:deploy",
    "db:generate": "pnpm run --dir apps/api prisma:generate",
    "db:migrate:reset": "pnpm run --dir apps/api prisma:migrate:reset",
    "db:format": "pnpm run --dir apps/api prisma:format",
    "worker:start": "pnpm --dir apps/worker start",
    "worker:dev": "pnpm --dir apps/worker start:dev",
    "worker:debug": "pnpm --dir apps/worker start:debug",
    "worker:prod": "pnpm --dir apps/worker start:prod",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Michael Akpuofoba",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0"
}
